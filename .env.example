# acer-mgmt 전역 .env 템플릿 — `.env` 로 복사해 실제 값 채움 (커밋 금지)
# 접근 방식: Tailscale 전용 + Traefik DNS-01(Cloudflare) 실제 HTTPS
# compose/Makefile이 이 파일을 --env-file로 모든 Compose 서비스에 주입.

# ── 공통 ─────────────────────────────────────
BASE_DOMAIN=mgmt.example.com        # 서비스 서브도메인 루트 (예: gitlab.${BASE_DOMAIN})
TZ=Asia/Seoul
PROXY_NET=mgmt-proxy                # 공용 외부 네트워크 (bootstrap 에서 생성)
DATA_ROOT=/home/mgmt-data           # 바인드 마운트 데이터 루트 (bootstrap 에서 생성)
TAILSCALE_IP=100.64.0.1             # ELK 수집 포트 등 tailnet 전용 bind 주소

# ── TLS: Traefik DNS-01 (Cloudflare) ─────────
# Cloudflare → My Profile → API Tokens → Create Token → "Edit zone DNS"
#   권한: Zone > DNS > Edit / 영역: 해당 도메인
CF_DNS_API_TOKEN=                   # (secret) DNS-01 챌린지 + (선택) A레코드 관리

# ── (선택) Cloudflare Tunnel 공개 노출 — Tailscale 전용이면 불필요 ─
#CF_TUNNEL_TOKEN=

# ── 서비스 계정 (실제 값은 긴 난수로 교체) ──────────────
ADMIN_PASSWORD=change-me-minimum-16-characters
MINIO_ROOT_USER=minioadmin
GRAFANA_ADMIN_USER=admin
GITLAB_ROOT_USER=root
SONAR_ADMIN_USER=admin
SEMAPHORE_ADMIN_USER=admin
SLACK_WEBHOOK_INFRA=                 # (secret) Grafana infra alerts Slack incoming webhook

# -- SSO/IAM: Keycloak + Grafana pilot -----------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=             # (secret) Keycloak bootstrap admin password
KEYCLOAK_DB_PASSWORD=                # (secret) Keycloak PostgreSQL password
KEYCLOAK_REALM=mgmt
GRAFANA_OAUTH_ENABLED=false
GRAFANA_OAUTH_CLIENT_ID=grafana
GRAFANA_OAUTH_CLIENT_SECRET=         # (secret) Keycloak confidential client secret

# ── 내부 DB/암호화 키 (서비스 계정과 별도 난수 권장) ────
SONAR_DB_PASSWORD=
SONAR_JWT_SECRET=
SEMAPHORE_DB_PASSWORD=
SEMAPHORE_ACCESS_KEY_ENCRYPTION=
SEMAPHORE_COOKIE_HASH=
SEMAPHORE_COOKIE_ENCRYPTION=
RESTIC_ACCESS_KEY=
RESTIC_SECRET_KEY=
RESTIC_PASSWORD=
HARBOR_DB_PASSWORD=
