# ── 전역 공통 (각 서비스는 자체 .env 로 보완) ──────────────
# 실제 값은 .env 로 복사해 채우고 커밋하지 않습니다.

BASE_DOMAIN=mgmt.example.com        # 모든 서비스 서브도메인의 루트 (예: gitlab.${BASE_DOMAIN})
TZ=Asia/Seoul
PROXY_NET=mgmt-proxy                # 공용 외부 네트워크 이름

# 컨테이너 영속 데이터 루트 — 디스크 제약상 /home 사용 (root LV 70GB뿐)
DATA_ROOT=/home/mgmt-data

# Traefik / ACME
ACME_EMAIL=admin@example.com        # Let's Encrypt 등록 이메일
