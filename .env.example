# acer-mgmt 전역 비시크릿 설정 템플릿
# `.env`로 복사해 호스트별 공통 설정만 채운다. 비밀번호, 토큰, 웹훅,
# 암호화 키는 Vault에서 관리하고 Vault Agent가 렌더링한 env 파일로 주입한다.
# 직접 docker compose 실행 시 env 파일 주입 순서:
#   1. ../.env
#   2. stacks/<domain>/<service>/.env        # 기존 호환용, 가능하면 사용하지 않음
#   3. /run/acer-mgmt/secrets/<domain>/<service>.env

# ── 공통 ─────────────────────────────────────
BASE_DOMAIN=mgmt.example.com        # 서비스 서브도메인 루트 (예: gitlab.${BASE_DOMAIN})
TZ=Asia/Seoul
PROXY_NET=mgmt-proxy                # 공용 외부 네트워크 (bootstrap 에서 생성)
DATA_ROOT=/home/mgmt-data           # 바인드 마운트 데이터 루트 (bootstrap 에서 생성)
TAILSCALE_IP=100.64.0.1             # ELK 수집 포트 등 tailnet 전용 bind 주소

# ── 서비스 계정 이름과 공개 설정 ───────────────────────
GRAFANA_ADMIN_USER=admin
GITLAB_ROOT_USER=root
SONAR_ADMIN_USER=admin
SEMAPHORE_ADMIN_USER=admin

# -- SSO/IAM: Keycloak + Grafana pilot -----------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_REALM=mgmt
TELEPORT_OIDC_CLIENT_ID=teleport

# -- NetBox IPAM/CMDB (infra/netbox) -------------------
# 비시크릿 값만. 패스워드/토큰/OIDC 시크릿은 Vault 로 관리한다.
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=imcherry5778@gmail.com
NETBOX_OIDC_CLIENT_ID=netbox

# -- ELK 감사 보안 (observability/elk) — W0 ------------
# 비시크릿: Logstash 최소권한 색인 계정명(기본 logstash_ingest).
ELK_LOGSTASH_USER=logstash_ingest
# 아래는 모두 Vault 로 관리하고 Vault Agent 가
#   /run/acer-mgmt/secrets/observability/elk.env 로 렌더링한다(값을 여기 두지 말 것):
#   ELK_ELASTIC_PASSWORD          # elastic superuser (부트스트랩/관리/apply)
#   ELK_KIBANA_PASSWORD           # kibana_system 서비스계정
#   ELK_LOGSTASH_PASSWORD         # logstash_ingest 색인계정
#   ELK_KIBANA_ENCRYPTION_KEY     # Kibana 세션 암호화 키(32자 이상)
#   ELK_KIBANA_SO_ENCRYPTION_KEY  # Kibana 저장객체 암호화 키(32자 이상)
# 스냅샷(선택, elk-snapshot-bootstrap.sh):
#   MINIO_ENDPOINT / SNAPSHOT_BUCKET / S3_ACCESS_KEY / S3_SECRET_KEY
