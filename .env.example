# acer-mgmt 전역 .env 템플릿 — `.env` 로 복사해 실제 값 채움 (커밋 금지)
# 노출 방식: Cloudflare Tunnel (TLS = Cloudflare 엣지에서 종단, 내부는 평문 HTTP)
# Makefile 이 `make up` 시 이 파일을 --env-file 로 모든 서비스에 주입.

# ── 공통 ─────────────────────────────────────
BASE_DOMAIN=mgmt.example.com        # 보유 도메인의 서브도메인 루트 (예: gitlab.${BASE_DOMAIN})
TZ=Asia/Seoul
PROXY_NET=mgmt-proxy                # 공용 외부 네트워크 (bootstrap 에서 생성)
DATA_ROOT=/home/mgmt-data           # 바인드 마운트 데이터 루트 (bootstrap 에서 생성)

# ── Cloudflare Tunnel ────────────────────────
# 발급: Cloudflare Zero Trust → Networks → Tunnels → Create a tunnel
#       → cloudflared 선택 → 표시되는 토큰(eyJ...) 복사
CF_TUNNEL_TOKEN=                    # (secret)

# ── 대안 경로용 (Cloudflare DNS-01 / 순정 LE 쓸 때만 주석 해제) ─
#ACME_EMAIL=you@example.com
#CF_DNS_API_TOKEN=
