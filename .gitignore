# ── 시크릿 / 환경변수 ───────────────────────────
.env
**/.env
!**/.env.example
secrets/*
!secrets/.gitkeep

# ── 런타임 상태 / 볼륨 ──────────────────────────
# 실제 런타임 데이터만 제외하고 stacks/data 소스 트리는 추적한다.
**/volumes/**/data/
**/acme.json
**/*.log
stacks/cicd/harbor/harbor.yml
stacks/cicd/harbor/docker-compose.yml
stacks/cicd/harbor/common/
# Harbor 오프라인 설치 프로그램 압축 해제 잔여물
stacks/cicd/harbor/LICENSE
stacks/cicd/harbor/install.sh
stacks/cicd/harbor/prepare

# ── 백업 파일 ───────────────────────────────────
*.old

# ── Homepage 컨테이너 기동 시 자동 생성하는 기본 stub ─
stacks/edge/homepage/config/custom.css
stacks/edge/homepage/config/custom.js
stacks/edge/homepage/config/docker.yaml
stacks/edge/homepage/config/kubernetes.yaml
stacks/edge/homepage/config/proxmox.yaml

# ── OS / 에디터 ─────────────────────────────────
.DS_Store
*.swp
