# Vault Agent rendered env schema example.
# Do not copy this file to a git-tracked path with real values.
#
# Runtime path convention:
#   /run/acer-mgmt/secrets/<domain>/<service>.env
#
# Example:
#   cd compose
#   docker compose --env-file ../.env \
#     --env-file /run/acer-mgmt/secrets/edge/traefik.env \
#     -f stacks/edge/traefik/compose.yaml up -d
# reads, if present:
#   ../.env
#   stacks/edge/traefik/.env
#   /run/acer-mgmt/secrets/edge/traefik.env

# Shared admin/bootstrap credentials used by legacy compose files.
ADMIN_PASSWORD=

# DNS/TLS and notification tokens.
CF_DNS_API_TOKEN=
CF_TUNNEL_TOKEN=
SLACK_WEBHOOK_INFRA=
SLACK_WEBHOOK_ARGOCD=

# Keycloak and OAuth.
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
GRAFANA_OAUTH_CLIENT_SECRET=
TELEPORT_OIDC_CLIENT_SECRET=

# Teleport TLS files are rendered from kv/mgmt/teleport to:
#   /run/acer-mgmt/secrets/security/teleport/tls.crt
#   /run/acer-mgmt/secrets/security/teleport/tls.key
TELEPORT_TLS_CERT_PEM=
TELEPORT_TLS_KEY_PEM=

# Service database passwords and signing/encryption keys.
SONAR_DB_PASSWORD=
SONAR_JWT_SECRET=
SEMAPHORE_DB_PASSWORD=
SEMAPHORE_ACCESS_KEY_ENCRYPTION=
SEMAPHORE_COOKIE_HASH=
SEMAPHORE_COOKIE_ENCRYPTION=
RESTIC_ACCESS_KEY=
RESTIC_SECRET_KEY=
RESTIC_PASSWORD=
HARBOR_DB_PASSWORD=

# Backup jobs. Source of truth is Vault, rendered by Vault Agent to:
#   /home/mgmt-data/vault-agent/secrets/backup-minio.env
#   /home/mgmt-data/vault-agent/secrets/offsite-s3.env
MINIO_ROOT_USER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# NetBox IPAM/CMDB (infra/netbox). SECRET_KEY 는 50자+ 랜덤,
# SUPERUSER_API_TOKEN 은 40 hex, OIDC_CLIENT_SECRET 은 Keycloak 클라이언트 시크릿.
NETBOX_DB_PASSWORD=
NETBOX_REDIS_PASSWORD=
NETBOX_REDIS_CACHE_PASSWORD=
NETBOX_SECRET_KEY=
NETBOX_SUPERUSER_PASSWORD=
NETBOX_SUPERUSER_API_TOKEN=
NETBOX_OIDC_CLIENT_SECRET=

# Supabase upstream stack secrets are managed in its own stack contract.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
VAULT_ENC_KEY=
