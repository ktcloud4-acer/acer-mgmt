{
  "index_patterns": [
    "logs-system-*"
  ],
  "priority": 260,
  "template": {
    "settings": {
      "number_of_replicas": 0,
      "index.lifecycle.name": "logs-retention-90d",
      "index.highlight.max_analyzed_offset": 20000000
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "labels": {
          "properties": {
            "team": {
              "type": "keyword"
            },
            "user": {
              "type": "keyword"
            },
            "platform": {
              "type": "keyword"
            },
            "node_role": {
              "type": "keyword"
            },
            "log_type": {
              "type": "keyword"
            }
          }
        },
        "log": {
          "properties": {
            "level": {
              "type": "keyword"
            }
          }
        }
      }
    }
  },
  "_meta": {
    "managed_by": "acer-mgmt",
    "description": "System/auth logs routed by Logstash. Kept longer because auth and security-relevant events can land in these indices."
  }
}
