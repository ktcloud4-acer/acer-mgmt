{
  "title": "Security Audit Overview",
  "description": "Canonical security audit triage and investigation. Alert-routing copies are excluded to prevent double counting.",
  "time_range": {
    "from": "now-24h",
    "to": "now",
    "mode": "relative"
  },
  "refresh_interval": {
    "pause": false,
    "value": 60000
  },
  "query": {
    "language": "kql",
    "expression": ""
  },
  "options": {
    "hide_panel_titles": false,
    "hide_panel_borders": false,
    "use_margins": true,
    "auto_apply_filters": true,
    "sync_colors": false,
    "sync_cursor": true,
    "sync_tooltips": true
  },
  "pinned_panels": [
    {
      "id": "audit-control-source",
      "type": "options_list_control",
      "width": "medium",
      "grow": true,
      "config": {
        "title": "Audit source",
        "data_view_id": "acer-audit",
        "field_name": "labels.audit_source.keyword",
        "use_global_filters": true,
        "single_select": false,
        "search_technique": "wildcard",
        "sort": {
          "by": "_count",
          "direction": "desc"
        }
      }
    },
    {
      "id": "audit-control-team",
      "type": "options_list_control",
      "width": "small",
      "grow": false,
      "config": {
        "title": "Team",
        "data_view_id": "acer-audit",
        "field_name": "labels.team.keyword",
        "use_global_filters": true,
        "single_select": false,
        "search_technique": "wildcard",
        "sort": {
          "by": "_count",
          "direction": "desc"
        }
      }
    },
    {
      "id": "audit-control-alert",
      "type": "options_list_control",
      "width": "medium",
      "grow": true,
      "config": {
        "title": "Alert signature",
        "data_view_id": "acer-audit",
        "field_name": "labels.audit_alert.keyword",
        "use_global_filters": true,
        "single_select": false,
        "search_technique": "wildcard",
        "sort": {
          "by": "_count",
          "direction": "desc"
        }
      }
    },
    {
      "id": "audit-control-user",
      "type": "options_list_control",
      "width": "medium",
      "grow": true,
      "config": {
        "title": "User",
        "data_view_id": "acer-audit",
        "field_name": "user.name.keyword",
        "use_global_filters": true,
        "single_select": false,
        "search_technique": "wildcard",
        "sort": {
          "by": "_count",
          "direction": "desc"
        }
      }
    },
    {
      "id": "audit-control-host",
      "type": "options_list_control",
      "width": "medium",
      "grow": true,
      "config": {
        "title": "Host",
        "data_view_id": "acer-audit",
        "field_name": "host.name.keyword",
        "use_global_filters": true,
        "single_select": false,
        "search_technique": "wildcard",
        "sort": {
          "by": "_count",
          "direction": "desc"
        }
      }
    }
  ],
  "panels": [
    {
      "id": "audit-section-situation",
      "title": "Current situation",
      "collapsed": false,
      "grid": {
        "y": 0
      },
      "panels": [
        {
          "id": "audit-kpi-total",
          "type": "vis",
          "grid": {
            "x": 0,
            "y": 0,
            "w": 12,
            "h": 6
          },
          "config": {
            "type": "metric",
            "title": "Total audit events",
            "description": "Canonical audit events in the selected time range and filters.",
            "data_source": {
              "type": "esql",
              "query": "SET unmapped_fields=\"NULLIFY\"; FROM acer-audit-* METADATA _index | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND NOT (_index LIKE \"acer-audit-alerts-*\") | STATS events = COUNT(*)"
            },
            "sampling": 1,
            "ignore_global_filters": false,
            "metrics": [
              {
                "type": "primary",
                "column": "events",
                "label": "Events"
              }
            ]
          }
        },
        {
          "id": "audit-kpi-high-signal",
          "type": "vis",
          "grid": {
            "x": 12,
            "y": 0,
            "w": 12,
            "h": 6
          },
          "config": {
            "type": "metric",
            "title": "High-signal events",
            "description": "Canonical events stamped by a high-signal audit rule.",
            "data_source": {
              "type": "esql",
              "query": "SET unmapped_fields=\"NULLIFY\"; FROM acer-audit-* METADATA _index | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND NOT (_index LIKE \"acer-audit-alerts-*\") AND labels.audit_alert IS NOT NULL | STATS events = COUNT(*)"
            },
            "sampling": 1,
            "ignore_global_filters": false,
            "metrics": [
              {
                "type": "primary",
                "column": "events",
                "label": "High signal"
              }
            ]
          }
        },
        {
          "id": "audit-kpi-wazuh",
          "type": "vis",
          "grid": {
            "x": 24,
            "y": 0,
            "w": 12,
            "h": 6
          },
          "config": {
            "type": "metric",
            "title": "Wazuh alerts",
            "description": "Endpoint and host alerts supplied by Wazuh.",
            "data_source": {
              "type": "esql",
              "query": "SET unmapped_fields=\"NULLIFY\"; FROM acer-audit-* METADATA _index | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND NOT (_index LIKE \"acer-audit-alerts-*\") AND labels.audit_source.keyword == \"wazuh\" | STATS events = COUNT(*)"
            },
            "sampling": 1,
            "ignore_global_filters": false,
            "metrics": [
              {
                "type": "primary",
                "column": "events",
                "label": "Wazuh alerts"
              }
            ]
          }
        },
        {
          "id": "audit-kpi-sources",
          "type": "vis",
          "grid": {
            "x": 36,
            "y": 0,
            "w": 12,
            "h": 6
          },
          "config": {
            "type": "metric",
            "title": "Active audit sources",
            "description": "Distinct audit sources observed in the selected time range.",
            "data_source": {
              "type": "esql",
              "query": "SET unmapped_fields=\"NULLIFY\"; FROM acer-audit-* METADATA _index | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND NOT (_index LIKE \"acer-audit-alerts-*\") | STATS sources = COUNT_DISTINCT(labels.audit_source.keyword)"
            },
            "sampling": 1,
            "ignore_global_filters": false,
            "metrics": [
              {
                "type": "primary",
                "column": "sources",
                "label": "Active sources"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "audit-section-coverage",
      "title": "Trend and collection coverage",
      "collapsed": false,
      "grid": {
        "y": 9
      },
      "panels": [
        {
          "id": "audit-trend-events",
          "type": "vis",
          "grid": {
            "x": 0,
            "y": 0,
            "w": 32,
            "h": 14
          },
          "config": {
            "type": "xy",
            "title": "Audit events over time",
            "description": "Event volume by source. Sudden drops can indicate collection loss; spikes can indicate activity requiring a pivot.",
            "layers": [
              {
                "type": "line",
                "data_source": {
                  "type": "esql",
                  "query": "SET unmapped_fields=\"NULLIFY\"; FROM acer-audit-* METADATA _index | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND NOT (_index LIKE \"acer-audit-alerts-*\") | STATS events = COUNT(*) BY bucket = BUCKET(@timestamp, 75, ?_tstart, ?_tend), source = labels.audit_source.keyword | SORT bucket ASC"
                },
                "sampling": 1,
                "ignore_global_filters": false,
                "x": {
                  "column": "bucket",
                  "label": "Time"
                },
                "y": [
                  {
                    "column": "events",
                    "label": "Events"
                  }
                ],
                "breakdown_by": {
                  "column": "source",
                  "label": "Source"
                }
              }
            ]
          }
        },
        {
          "id": "audit-trend-sources",
          "type": "vis",
          "grid": {
            "x": 32,
            "y": 0,
            "w": 16,
            "h": 7
          },
          "config": {
            "type": "xy",
            "title": "Events by source",
            "description": "Relative audit volume by producer.",
            "layers": [
              {
                "type": "bar_horizontal",
                "data_source": {
                  "type": "esql",
                  "query": "SET unmapped_fields=\"NULLIFY\"; FROM acer-audit-* METADATA _index | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND NOT (_index LIKE \"acer-audit-alerts-*\") | STATS events = COUNT(*) BY source = labels.audit_source.keyword | SORT events DESC | LIMIT 10"
                },
                "sampling": 1,
                "ignore_global_filters": false,
                "x": {
                  "column": "source",
                  "label": "Source"
                },
                "y": [
                  {
                    "column": "events",
                    "label": "Events"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "audit-table-freshness",
          "type": "vis",
          "grid": {
            "x": 32,
            "y": 7,
            "w": 16,
            "h": 7
          },
          "config": {
            "type": "data_table",
            "title": "Source freshness",
            "description": "Oldest last-seen source is shown first so collection gaps stand out.",
            "data_source": {
              "type": "esql",
              "query": "SET unmapped_fields=\"NULLIFY\"; FROM acer-audit-* METADATA _index | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND NOT (_index LIKE \"acer-audit-alerts-*\") | STATS events = COUNT(*), last_seen = MAX(@timestamp) BY source = labels.audit_source.keyword | SORT last_seen ASC"
            },
            "sampling": 1,
            "ignore_global_filters": false,
            "rows": [
              {
                "column": "source",
                "label": "Source",
                "width": 120
              },
              {
                "column": "last_seen",
                "label": "Last seen",
                "width": 180
              }
            ],
            "metrics": [
              {
                "column": "events",
                "label": "Events",
                "width": 90
              }
            ]
          }
        }
      ]
    },
    {
      "id": "audit-section-immediate",
      "title": "Immediate investigation",
      "collapsed": false,
      "grid": {
        "y": 26
      },
      "panels": [
        {
          "id": "audit-table-high-signal",
          "type": "vis",
          "grid": {
            "x": 0,
            "y": 0,
            "w": 48,
            "h": 16
          },
          "config": {
            "type": "data_table",
            "title": "Recent high-signal events",
            "description": "Newest canonical events matched by Vault or Wazuh high-signal rules.",
            "data_source": {
              "type": "esql",
              "query": "SET unmapped_fields=\"NULLIFY\"; FROM acer-audit-* METADATA _index | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND NOT (_index LIKE \"acer-audit-alerts-*\") AND labels.audit_alert IS NOT NULL | SORT @timestamp DESC | KEEP @timestamp, event.severity, labels.audit_alert, labels.audit_source, labels.team, user.name, host.name, event.action, event.code, url.path | LIMIT 100"
            },
            "sampling": 1,
            "ignore_global_filters": false,
            "rows": [
              {
                "column": "@timestamp",
                "label": "Time",
                "width": 190
              },
              {
                "column": "event.severity",
                "label": "Severity",
                "width": 90
              },
              {
                "column": "labels.audit_alert",
                "label": "Alert signature",
                "width": 190
              },
              {
                "column": "labels.audit_source",
                "label": "Source",
                "width": 110
              },
              {
                "column": "labels.team",
                "label": "Team",
                "width": 80
              },
              {
                "column": "user.name",
                "label": "User",
                "width": 130
              },
              {
                "column": "host.name",
                "label": "Host",
                "width": 130
              },
              {
                "column": "event.action",
                "label": "Action",
                "width": 260
              },
              {
                "column": "event.code",
                "label": "Code",
                "width": 90
              },
              {
                "column": "url.path",
                "label": "Resource path",
                "width": 220
              }
            ]
          }
        }
      ]
    },
    {
      "id": "audit-section-pivots",
      "title": "Behavioral pivots",
      "collapsed": false,
      "grid": {
        "y": 45
      },
      "panels": [
        {
          "id": "audit-pivot-actions",
          "type": "vis",
          "grid": {
            "x": 0,
            "y": 0,
            "w": 24,
            "h": 13
          },
          "config": {
            "type": "xy",
            "title": "Top actions",
            "description": "Most frequent normalized Teleport, Vault, and Wazuh actions.",
            "layers": [
              {
                "type": "bar_horizontal",
                "data_source": {
                  "type": "esql",
                  "query": "SET unmapped_fields=\"NULLIFY\"; FROM acer-audit-* METADATA _index | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND NOT (_index LIKE \"acer-audit-alerts-*\") AND event.action IS NOT NULL | STATS events = COUNT(*) BY action = event.action.keyword | SORT events DESC | LIMIT 15"
                },
                "sampling": 1,
                "ignore_global_filters": false,
                "x": {
                  "column": "action",
                  "label": "Action"
                },
                "y": [
                  {
                    "column": "events",
                    "label": "Events"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "audit-pivot-users",
          "type": "vis",
          "grid": {
            "x": 24,
            "y": 0,
            "w": 12,
            "h": 13
          },
          "config": {
            "type": "xy",
            "title": "Top users",
            "description": "Most active normalized Teleport and Vault users.",
            "layers": [
              {
                "type": "bar_horizontal",
                "data_source": {
                  "type": "esql",
                  "query": "SET unmapped_fields=\"NULLIFY\"; FROM acer-audit-* METADATA _index | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND NOT (_index LIKE \"acer-audit-alerts-*\") AND user.name IS NOT NULL | STATS events = COUNT(*) BY user = user.name.keyword | SORT events DESC | LIMIT 10"
                },
                "sampling": 1,
                "ignore_global_filters": false,
                "x": {
                  "column": "user",
                  "label": "User"
                },
                "y": [
                  {
                    "column": "events",
                    "label": "Events"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "audit-pivot-hosts",
          "type": "vis",
          "grid": {
            "x": 36,
            "y": 0,
            "w": 12,
            "h": 13
          },
          "config": {
            "type": "xy",
            "title": "Top hosts",
            "description": "Most active Wazuh hosts in the selected range.",
            "layers": [
              {
                "type": "bar_horizontal",
                "data_source": {
                  "type": "esql",
                  "query": "SET unmapped_fields=\"NULLIFY\"; FROM acer-audit-* METADATA _index | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND NOT (_index LIKE \"acer-audit-alerts-*\") AND host.name IS NOT NULL | STATS events = COUNT(*) BY host = host.name.keyword | SORT events DESC | LIMIT 10"
                },
                "sampling": 1,
                "ignore_global_filters": false,
                "x": {
                  "column": "host",
                  "label": "Host"
                },
                "y": [
                  {
                    "column": "events",
                    "label": "Events"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "audit-section-timeline",
      "title": "Full audit timeline",
      "collapsed": false,
      "grid": {
        "y": 61
      },
      "panels": [
        {
          "id": "audit-table-timeline",
          "type": "vis",
          "grid": {
            "x": 0,
            "y": 0,
            "w": 48,
            "h": 20
          },
          "config": {
            "type": "data_table",
            "title": "Full audit timeline",
            "description": "Newest canonical audit events for the current time range and filters.",
            "data_source": {
              "type": "esql",
              "query": "SET unmapped_fields=\"NULLIFY\"; FROM acer-audit-* METADATA _index | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND NOT (_index LIKE \"acer-audit-alerts-*\") | SORT @timestamp DESC | KEEP @timestamp, labels.audit_source, labels.team, labels.service, event.severity, labels.audit_alert, user.name, host.name, event.action, event.code, url.path, message | LIMIT 200"
            },
            "sampling": 1,
            "ignore_global_filters": false,
            "rows": [
              {
                "column": "@timestamp",
                "label": "Time",
                "width": 190
              },
              {
                "column": "labels.audit_source",
                "label": "Source",
                "width": 110
              },
              {
                "column": "labels.team",
                "label": "Team",
                "width": 80
              },
              {
                "column": "labels.service",
                "label": "Service",
                "width": 110
              },
              {
                "column": "event.severity",
                "label": "Severity",
                "width": 90
              },
              {
                "column": "labels.audit_alert",
                "label": "Alert signature",
                "width": 190
              },
              {
                "column": "user.name",
                "label": "User",
                "width": 130
              },
              {
                "column": "host.name",
                "label": "Host",
                "width": 130
              },
              {
                "column": "event.action",
                "label": "Action",
                "width": 260
              },
              {
                "column": "event.code",
                "label": "Code",
                "width": 90
              },
              {
                "column": "url.path",
                "label": "Resource path",
                "width": 220
              },
              {
                "column": "message",
                "label": "Message",
                "width": 420
              }
            ]
          }
        }
      ]
    }
  ]
}
