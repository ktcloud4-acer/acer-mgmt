{
  "index_patterns": ["acer-audit-*"],
  "priority": 250,
  "_meta": {
    "managed_by": "acer-mgmt",
    "description": "보안 감사 인덱스 기본 설정: 단일노드 replica0(yellow→green) + 감사 전용 90일 보존 ILM. 우선순위 250 으로 일반 로그 템플릿(acer-logs, 200)보다 구체적."
  },
  "template": {
    "settings": {
      "number_of_replicas": 0,
      "index.lifecycle.name": "acer-audit-retention"
    },
    "mappings": {
      "properties": {
        "actor": {
          "properties": {
            "id": { "type": "keyword" },
            "name": { "type": "keyword" }
          }
        },
        "event": {
          "properties": {
            "category": { "type": "keyword" },
            "outcome": { "type": "keyword" },
            "sequence": { "type": "long" }
          }
        },
        "http": {
          "properties": {
            "request": {
              "properties": {
                "method": { "type": "keyword" },
                "referrer": { "type": "wildcard" }
              }
            },
            "response": {
              "properties": {
                "body": {
                  "properties": {
                    "bytes": { "type": "long" }
                  }
                },
                "status_code": { "type": "integer" }
              }
            },
            "version": { "type": "keyword" }
          }
        },
        "labels": {
          "properties": {
            "audit_alert": { "type": "keyword" }
          }
        },
        "observer": {
          "properties": {
            "name": { "type": "keyword" }
          }
        },
        "source": {
          "properties": {
            "ip": { "type": "ip" }
          }
        },
        "trace": {
          "properties": {
            "id": { "type": "keyword" }
          }
        },
        "traefik": {
          "properties": {
            "backend": {
              "properties": {
                "address": { "type": "keyword", "ignore_above": 1024 }
              }
            },
            "router": {
              "properties": {
                "name": { "type": "keyword" }
              }
            }
          }
        },
        "url": {
          "properties": {
            "domain": { "type": "keyword" },
            "original": { "type": "wildcard" },
            "path": {
              "type": "text",
              "fields": {
                "keyword": { "type": "keyword", "ignore_above": 1024 }
              }
            },
            "query": { "type": "wildcard" }
          }
        },
        "user_agent": {
          "properties": {
            "original": { "type": "wildcard" }
          }
        }
      }
    }
  }
}
