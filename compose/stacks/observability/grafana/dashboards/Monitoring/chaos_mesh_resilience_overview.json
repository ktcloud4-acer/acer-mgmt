        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (cluster) (chaos_controller_manager_chaos_experiments{cluster=~\"$cluster\",exported_namespace=~\"$namespace\",phase=\"paused\"})",
          "legendFormat": "{{cluster}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Paused Experiments",
      "type": "stat"
