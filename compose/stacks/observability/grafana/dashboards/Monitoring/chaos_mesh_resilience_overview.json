{
  "annotations": { "list": [] },
  "description": "Read-only central view of Chaos Mesh experiment state, ScaleCart SLOs, and Kubernetes readiness. This dashboard has no Kubernetes or Chaos Mesh action integration.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "All configured team clusters are shown. A value of 0 means Unavailable; it is never treated as Healthy.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (cluster) (up{job=\"chaos-mesh-controller\",cluster=~\"$cluster\"}) or label_replace(vector(0), \"cluster\", \"ggg\", \"cluster\", \".*\") or label_replace(vector(0), \"cluster\", \"khb\", \"cluster\", \".*\") or label_replace(vector(0), \"cluster\", \"ljw\", \"cluster\", \".*\") or label_replace(vector(0), \"cluster\", \"nmg\", \"cluster\", \".*\") or label_replace(vector(0), \"cluster\", \"oje\", \"cluster\", \".*\")",
          "legendFormat": "{{cluster}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Chaos Controller Availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (cluster) (chaos_controller_manager_chaos_experiments{cluster=~\"$cluster\",exported_namespace=~\"$namespace\",phase!=\"paused\"})",
          "legendFormat": "{{cluster}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Non-paused Experiments",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
