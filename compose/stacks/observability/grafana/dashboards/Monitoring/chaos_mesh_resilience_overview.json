          "legendFormat": "{{cluster}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Ready Nodes",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [], "noValue": "No experiment data" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "options": { "cellHeight": "sm", "showHeader": true, "sortBy": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (cluster, kind, exported_namespace, phase) (chaos_controller_manager_chaos_experiments{cluster=~\"$cluster\",exported_namespace=~\"$namespace\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Experiment State by Cluster",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [], "noValue": "No warning events" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "options": {
        "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (cluster, reason) (increase(chaos_controller_manager_emitted_event_total{cluster=~\"$cluster\",type=\"Warning\"}[$__rate_interval]))",
          "legendFormat": "{{cluster}} {{reason}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Chaos Warning Events",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.005 },
              { "color": "red", "value": 0.02 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
