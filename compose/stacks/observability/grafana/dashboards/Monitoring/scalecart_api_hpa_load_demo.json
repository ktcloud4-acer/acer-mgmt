        { "editorMode": "code", "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"scalecart\",horizontalpodautoscaler=\"scalecart-api\",cluster=~\"$cluster\"}", "legendFormat": "desired {{cluster}}", "refId": "B" }
