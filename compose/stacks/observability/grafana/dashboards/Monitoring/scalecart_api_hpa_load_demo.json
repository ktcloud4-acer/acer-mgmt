      ],
      "title": "k6 Load: API Request Rate and P95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.7 }] }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "sum by(cluster) (rate(container_cpu_usage_seconds_total{namespace=\"scalecart\",pod=~\"scalecart-api-.*\",container!=\"\",image!=\"\"}[1m])) / sum by(cluster) (kube_pod_container_resource_requests{namespace=\"scalecart\",pod=~\"scalecart-api-.*\",resource=\"cpu\",unit=\"core\"})", "legendFormat": "CPU / request {{cluster}}", "refId": "A" }],
      "title": "API CPU Utilisation (HPA target 70%)",
